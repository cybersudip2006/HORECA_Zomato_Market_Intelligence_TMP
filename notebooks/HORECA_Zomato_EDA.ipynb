   "source": [
    "## 2. Build analysis-ready tables\n",
    "\n",
    "Create one row per outlet for city/channel analysis and one row per outlet-cuisine pair for cuisine analysis. Use the median of repeated values so each outlet contributes once, rather than once per menu item.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "767c1666",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-26T06:42:46.627689Z",
     "iopub.status.busy": "2026-11-26T06:42:46.627597Z",
     "iopub.status.idle": "2026-11-26T06:42:46.746525Z",
     "shell.execute_reply": "2026-11-26T06:42:46.746087Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Restaurant rows: 914 outlet-cuisine rows: 915\n"
     ]
    }
   ],
   "source": [
    "restaurant_cols = [\"Dining_Rating\", \"Delivery_Rating\", \"Dining_Votes\", \"Delivery_Votes\",\n",
    "                   \"Average_Rating\", \"Total_Votes\", \"Restaurant_Popularity\",\n",
    "                   \"Avg_Rating_Restaurant\", \"Avg_Price_Restaurant\"]\n",
    "restaurant = (df.groupby(\"Restaurant_Key\", as_index=False)\n",
    "              .agg(Restaurant_Name=(\"Restaurant_Name\", \"first\"), City=(\"City\", \"first\"),\n",
    "                   Place_Name=(\"Place_Name\", \"first\"),\n",
    "                   **{c: (c, \"median\") for c in restaurant_cols}))\n",
    "restaurant[\"Average_Rating\"] = restaurant[\"Average_Rating\"].fillna(\n",
    "    restaurant[[\"Dining_Rating\", \"Delivery_Rating\"]].mean(axis=1))\n",
    "restaurant[\"Total_Votes\"] = restaurant[\"Total_Votes\"].fillna(\n",
    "    restaurant[[\"Dining_Votes\", \"Delivery_Votes\"]].fillna(0).sum(axis=1))\n",
    "restaurant[\"Is_Highly_Rated_Recomputed\"] = (restaurant[\"Average_Rating\"] >= 4.0).astype(int)\n",
    "\n",
    "restaurant_cuisine = (df.groupby([\"Restaurant_Key\", \"Cuisine\"], as_index=False)\n",
    "    .agg(Restaurant_Name=(\"Restaurant_Name\", \"first\"), City=(\"City\", \"first\"),\n",
    "         Place_Name=(\"Place_Name\", \"first\"), Average_Rating=(\"Average_Rating\", \"median\"),\n",
    "         Total_Votes=(\"Total_Votes\", \"median\"), Dining_Rating=(\"Dining_Rating\", \"median\"),\n",
    "         Delivery_Rating=(\"Delivery_Rating\", \"median\")))\n",
    "print(\"Restaurant rows:\", len(restaurant), \"outlet-cuisine rows:\", len(restaurant_cuisine))\n"
   ]
  },
