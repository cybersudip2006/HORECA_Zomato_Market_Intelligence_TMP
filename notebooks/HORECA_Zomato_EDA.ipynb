   "source": [
    "cuisine_summary = (restaurant_cuisine.groupby(\"Cuisine\", as_index=False)\n",
    "    .agg(Restaurants=(\"Restaurant_Key\", \"nunique\"), Average_Rating=(\"Average_Rating\", \"mean\"),\n",
    "         Median_Total_Votes=(\"Total_Votes\", \"median\"), Total_Votes_Sum=(\"Total_Votes\", \"sum\"),\n",
    "         Dining_Rating=(\"Dining_Rating\", \"mean\"), Delivery_Rating=(\"Delivery_Rating\", \"mean\")))\n",
    "price_by_cuisine = df.groupby(\"Cuisine\")[\"Prices\"].agg(Mean_Price=\"mean\", Median_Price=\"median\", Item_Rows=\"size\")\n",
    "cuisine_summary = cuisine_summary.merge(price_by_cuisine, on=\"Cuisine\", how=\"left\")\n",
    "cuisine_summary[\"Delivery_minus_Dining\"] = cuisine_summary[\"Delivery_Rating\"] - cuisine_summary[\"Dining_Rating\"]\n",
    "shortlist = cuisine_summary.query(\"Restaurants >= 10\").sort_values(\"Median_Total_Votes\", ascending=False)\n",
    "display(shortlist.head(15).round(2))\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9, 5))\n",
    "plot_data = shortlist.copy()\n",
    "sns.scatterplot(data=plot_data, x=\"Median_Total_Votes\", y=\"Average_Rating\", size=\"Restaurants\",\n",
    "                sizes=(50, 500), hue=\"Cuisine\", legend=False, ax=ax)\n",
    "for _, row in plot_data[plot_data[\"Cuisine\"].isin([\"Desserts\", \"Kebab\", \"Beverages\", \"Pizza\", \"Fast Food\"])].iterrows():\n",
    "    ax.annotate(row[\"Cuisine\"], (row[\"Median_Total_Votes\"], row[\"Average_Rating\"]), xytext=(4, 4), textcoords=\"offset points\")\n",
    "ax.set_title(\"Cuisine positioning: demand vs quality\"); plt.tight_layout(); plt.show()\n"
   ]
  },
