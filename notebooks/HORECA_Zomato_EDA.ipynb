    "# Clean text labels and convert numeric columns safely.\n",
    "text_cols = [\"Restaurant_Name\", \"Cuisine\", \"Place_Name\", \"City\", \"Best_Seller\"]\n",
    "for col in text_cols:\n",
    "    df[col] = df[col].astype(\"string\").str.strip()\n",
    "num_cols = [\"Dining_Rating\", \"Delivery_Rating\", \"Dining_Votes\", \"Delivery_Votes\", \"Votes\",\n",
    "            \"Prices\", \"Average_Rating\", \"Total_Votes\", \"Price_per_Vote\", \"Log_Price\",\n",
    "            \"Is_Bestseller\", \"Restaurant_Popularity\", \"Avg_Rating_Restaurant\",\n",
    "            \"Avg_Price_Restaurant\", \"Avg_Rating_Cuisine\", \"Avg_Price_Cuisine\",\n",
    "            \"Avg_Rating_City\", \"Avg_Price_City\", \"Is_Highly_Rated\", \"Is_Expensive\"]\n",
    "for col in num_cols:\n",
    "    df[col] = pd.to_numeric(df[col], errors=\"coerce\")\n",
    "# Composite key for one restaurant outlet.\n",
    "df[\"Restaurant_Key\"] = (df[\"Restaurant_Name\"].str.casefold() + \"|\" +\n",
    "                         df[\"City\"].str.casefold() + \"|\" + df[\"Place_Name\"].str.casefold())\n"
   ]
  },
