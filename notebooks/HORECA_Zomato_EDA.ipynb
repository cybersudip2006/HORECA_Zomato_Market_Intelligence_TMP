    "paired = restaurant[[\"Dining_Rating\", \"Delivery_Rating\", \"Dining_Votes\", \"Delivery_Votes\"]].dropna(subset=[\"Dining_Rating\", \"Delivery_Rating\"]).copy()\n",
    "paired[\"Delivery_minus_Dining_Rating\"] = paired[\"Delivery_Rating\"] - paired[\"Dining_Rating\"]\n",
    "print(\"Mean dining rating:\", paired[\"Dining_Rating\"].mean())\n",
    "print(\"Mean delivery rating:\", paired[\"Delivery_Rating\"].mean())\n",
    "print(\"Mean paired difference:\", paired[\"Delivery_minus_Dining_Rating\"].mean())\n",
    "print(\"Pearson r:\", stats.pearsonr(paired[\"Dining_Rating\"], paired[\"Delivery_Rating\"]))\n",
    "print(\"Paired t-test:\", stats.ttest_rel(paired[\"Delivery_Rating\"], paired[\"Dining_Rating\"]))\n",
    "print(\"Dining/Delivery vote medians:\", paired[\"Dining_Votes\"].median(), paired[\"Delivery_Votes\"].median())\n",
    "print(\"Non-zero vote counts:\", (paired[\"Dining_Votes\"] > 0).sum(), (paired[\"Delivery_Votes\"] > 0).sum())\n",
    "\n",
    "channel_means = pd.DataFrame({\"Channel\": [\"Dining\", \"Delivery\"],\n",
    "                              \"Average_Rating\": [paired[\"Dining_Rating\"].mean(), paired[\"Delivery_Rating\"].mean()]})\n",
    "sns.barplot(data=channel_means, x=\"Channel\", y=\"Average_Rating\", hue=\"Channel\", legend=False, palette=[\"#14263D\", \"#1F8A8A\"])\n",
    "plt.ylim(0, 5); plt.title(\"Mean restaurant rating by channel\"); plt.tight_layout(); plt.show()\n"
   ]
