    "city_metrics = (restaurant.groupby(\"City\", as_index=False)\n",
    "    .agg(Restaurants=(\"Restaurant_Key\", \"nunique\"), Average_Rating=(\"Average_Rating\", \"mean\"),\n",
    "         Median_Total_Votes=(\"Total_Votes\", \"median\"), High_Rated_Count=(\"Is_Highly_Rated_Recomputed\", \"sum\")))\n",
    "price_by_city = df.groupby(\"City\")[\"Prices\"].agg(Mean_Item_Price=\"mean\", Median_Item_Price=\"median\")\n",
    "city_metrics = city_metrics.merge(price_by_city, on=\"City\", how=\"left\")\n",
    "city_metrics[\"High_Rated_Share\"] = city_metrics[\"High_Rated_Count\"] / city_metrics[\"Restaurants\"]\n",
    "city_metrics[\"Price_to_Rating_Ratio\"] = city_metrics[\"Mean_Item_Price\"] / city_metrics[\"Average_Rating\"]\n",
    "city_metrics = city_metrics.query(\"Restaurants >= 20\").sort_values(\"Median_Total_Votes\", ascending=False)\n",
    "display(city_metrics.round(2))\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9, 5))\n",
    "sns.scatterplot(data=city_metrics, x=\"Median_Total_Votes\", y=\"Average_Rating\",\n",
    "                size=\"Restaurants\", sizes=(60, 600), hue=\"City\", legend=False, ax=ax)\n",
    "for _, row in city_metrics.iterrows():\n",
    "    ax.annotate(row[\"City\"], (row[\"Median_Total_Votes\"], row[\"Average_Rating\"]), xytext=(4, 4), textcoords=\"offset points\", fontsize=8)\n",
    "ax.set_title(\"City opportunity: median demand vs average rating\"); plt.tight_layout(); plt.show()\n",
    "\n",
    "# Detailed place-level comparison for Ahmedabad, the demand-led city shortlist.\n",
    "ahmedabad = restaurant.query(\"City == 'Ahmedabad'\")\n",
    "place_summary = (ahmedabad.groupby(\"Place_Name\", as_index=False)\n",
    "    .agg(Restaurants=(\"Restaurant_Key\", \"nunique\"), Average_Rating=(\"Average_Rating\", \"mean\"),\n",
    "         Median_Total_Votes=(\"Total_Votes\", \"median\"), Mean_Menu_Breadth=(\"Restaurant_Popularity\", \"mean\")))\n",
    "place_summary = place_summary.merge(df.query(\"City == 'Ahmedabad'\").groupby(\"Place_Name\")[\"Prices\"].mean().rename(\"Mean_Item_Price\"), on=\"Place_Name\")\n",
    "display(place_summary.query(\"Restaurants >= 2\").sort_values(\"Median_Total_Votes\", ascending=False).head(12).round(2))\n"
   ]
